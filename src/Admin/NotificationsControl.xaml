<UserControl x:Class="Technic_accounting.NotificationsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Technic_accounting"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1100"
             Name="NotificationsTab">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Центр уведомлений и заявок" FontSize="26" FontWeight="Light" Foreground="#333333"/>
            <Border Background="#E53E3E" CornerRadius="10" Padding="8,2" Margin="15,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtNewCount" Text="0 новых" Foreground="White" FontSize="12" FontWeight="Bold"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4.5*"/>
                <ColumnDefinition Width="3.5*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource DashboardCard}" Padding="15" Margin="0,0,20,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🔔 Входящие обращения студентов" FontSize="15" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>

                    <ListBox x:Name="LbNotifications" Grid.Row="1" Background="Transparent" BorderThickness="0" 
                             SelectionChanged="LbNotifications_SelectionChanged" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="#EDF2F7" Padding="5,8,5,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding ContentText}" FontSize="13" Foreground="#2D3748" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding StudentName}" FontSize="11" Foreground="#718096" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Timestamp}" FontSize="11" Foreground="#A0AEC0" HorizontalAlignment="Right"/>
                                            <Border CornerRadius="3" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Right">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#EDF2F7"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Новое">
                                                                <Setter Property="Background" Value="#FED7D7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#4A5568"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Новое">
                                                                    <Setter Property="Foreground" Value="#E53E3E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Border x:Name="PanelPlaceholder" Style="{StaticResource DashboardCard}" Padding="20" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Выберите заявку из списка" FontSize="16" FontWeight="Medium" Foreground="#718096" HorizontalAlignment="Center"/>
                        <TextBlock Text="чтобы просмотреть детали и принять решение" FontSize="12" Foreground="#A0AEC0" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="PanelDetails" Style="{StaticResource DashboardCard}" Padding="20" Visibility="Visible">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Name="lblDetailsType" Text="Тип заявки" FontSize="18" FontWeight="Bold" Foreground="#4E73DF" TextWrapping="Wrap"/>
                            <Separator Margin="0,10,0,10" Background="#E3E6F0"/>

                            <TextBlock Text="Отправитель:" FontSize="11" Foreground="#858796" FontWeight="SemiBold"/>
                            <TextBlock Name="lblDetailsStudent" Text="Имя студента" FontSize="14" FontWeight="Medium" Foreground="#333333" Margin="0,2,0,8"/>

                            <TextBlock Text="Номер студенческого:" FontSize="11" Foreground="#858796" FontWeight="SemiBold"/>
                            <TextBlock Name="lblDetailsTelegram" Text="@telegram_tag" FontSize="14" Foreground="#1ABC9C" FontWeight="Medium"/>
                        </StackPanel>

                        <Border Grid.Row="1" Background="#F8F9FC" CornerRadius="4" Padding="12" Margin="0,0,0,15">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Описание / Технические данные:" FontSize="11" Foreground="#858796" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock Name="lblDetailsDescription" Text="Текст проблемы..." FontSize="13" Foreground="#444444" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <StackPanel Grid.Row="2">
                            <StackPanel.Resources>
                                <Style TargetType="Button">
                                    <Setter Property="Height" Value="36"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Style.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Style.Resources>
                                </Style>
                            </StackPanel.Resources>

                            <StackPanel Name="PanelActionButtons" Visibility="Visible">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Name="BtnConfirm" Click="BtnConfirm_Click" Content="✅ Подтвердить" Background="#2ECC71" Grid.Column="0" Margin="0,0,4,10"/>
                                    <Button Name="BtnDecline" Click="BtnDecline_Click" Content="❌ Отклонить" Background="#E53E3E" Grid.Column="1" Margin="4,0,0,10"/>
                                </Grid>
                                
                                <Button Name="BtnCreateDbRecord" Click="BtnCreateDbRecord_Click" Content="💾 Создать запись в БД" Background="#F6AD55"/>

                                <Button Name="BtnSendReply" Click="BtnSendReply_Click" Content="💬 Отправить ответ студенту" Background="#3498DB" Margin="0,0,0,0">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Сейчас подойду" Click="ReplyComeHere_Click"/>
                                            <MenuItem Header="Подойди ко мне на первый этаж" Click="ReplyFirstFloor_Click"/>
                                            <MenuItem Header="Отправить актуальные данные (Из БД)" Click="ReplyActualData_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Ввести вручную..." Click="ReplyManual_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>

                            <StackPanel Name="PanelManualReply" Visibility="Collapsed">
                                <TextBlock Text="Сообщение студенту:" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4"/>
                                <TextBox Name="TxtCustomReply" Height="70" TextWrapping="Wrap" AcceptsReturn="True" 
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" Padding="4"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Name="BtnSendCustomReply" Click="BtnSendCustomReply_Click" Content="🚀 Отправить" Background="#2ECC71" Grid.Column="0" Margin="0,0,4,0"/>
                                    <Button Name="BtnCancelCustomReply" Click="BtnCancelCustomReply_Click" Content="Отмена" Background="#95A5A6" Grid.Column="1" Margin="4,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>