<UserControl x:Class="Technic_accounting.JournalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Technic_accounting"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="1000">
    <Grid Margin="25,25,25,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Журнал учета и сессий" FontSize="26" FontWeight="Light" Foreground="#333333" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="White" CornerRadius="6" BorderThickness="1" BorderBrush="#E3E6F0" Padding="15,15,15,15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.Resources>
                    <Style x:Key="FilterLabel" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="#4E73DF"/>
                        <Setter Property="Margin" Value="0,0,0,5"/>
                    </Style>
                </Grid.Resources>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Период (Дата):" Style="{StaticResource FilterLabel}"/>
                    <DatePicker Name="dpDate" Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5,0,10,0">
                    <TextBlock Text="Студент:" Style="{StaticResource FilterLabel}"/>
                    <ComboBox Name="cbStudent" DisplayMemberPath="FullInfo" SelectedValuePath="user_id" Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="5,0,10,0">
                    <TextBlock Text="Группа:" Style="{StaticResource FilterLabel}"/>
                    <ComboBox Name="cbJournalGroup" DisplayMemberPath="FullInfo" SelectedValuePath="group_id" Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="5,0,10,0">
                    <TextBlock Text="Оборудование:" Style="{StaticResource FilterLabel}"/>
                    <ComboBox Name="cbEquipment" DisplayMemberPath="FullInfo" SelectedValuePath="equipment_id" Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="5,0,15,0">
                    <TextBlock Text="Кабинет:" Style="{StaticResource FilterLabel}"/>
                    <ComboBox Name="cbJournalRoom" DisplayMemberPath="FullInfo" SelectedValuePath="room_id" Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="5,0,0,0">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                        <TextBlock Text="Статус сессий:" Style="{StaticResource FilterLabel}"/>
                        <ComboBox Name="cbJournalSessionStatus" Width="120" Height="32" SelectedIndex="0" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Все записи"/>
                            <ComboBoxItem Content="Активные"/>
                            <ComboBoxItem Content="Закрытые"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,2">
                        <CheckBox Name="chbAll" Content="Выгрузить все записи" Checked="chbAll_Checked" Unchecked="chbAll_Unchecked" Margin="0,0,0,4" FontWeight="Medium" VerticalContentAlignment="Center"/>
                        <CheckBox Name="chbJournalProblems" Content="Только проблемы" Foreground="#E53E3E" FontWeight="Medium" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="6" BorderThickness="1" BorderBrush="#E3E6F0">
            <DataGrid Name="dgPreview" AutoGenerateColumns="True" IsReadOnly="True" 
                      Background="Transparent" AlternatingRowBackground="#F9F9F9" BorderThickness="0" RowHeaderWidth="0"/>
        </Border>

        <Grid Grid.Row="3" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                
                <Button x:Name="BtnCloseSession" Click="CloseSession_Click" Width="160" Height="38" Margin="0,0,10,0" Background="#F6AD55" Foreground="White" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔒 " VerticalAlignment="Center"/>
                        <TextBlock Text="Закрыть сессию" VerticalAlignment="Center" FontWeight="Medium"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnRefreshJournal" Click="Generate_Click" Width="110" Height="38" Margin="0,0,10,0" Background="#858796" Foreground="White" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄 " VerticalAlignment="Center"/>
                        <TextBlock Text="Обновить" VerticalAlignment="Center" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnImportExcel" Click="ImportExcel_Click" Width="140" Height="38" Margin="0,0,10,0" Background="#2ECC71" Foreground="White" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📥 " VerticalAlignment="Center"/>
                        <TextBlock Text="Импорт Excel" VerticalAlignment="Center" FontWeight="Medium"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnExportExcel" Click="ExportReport_Click" Width="140" Height="38" Background="#3498DB" Foreground="White" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📤 " VerticalAlignment="Center"/>
                        <TextBlock Text="Экспорт Excel" VerticalAlignment="Center" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border x:Name="PanelImportConfirmation" 
                    Background="#E9ECEF" 
                    Padding="5,4,5,4" 
                    HorizontalAlignment="Right"
                    CornerRadius="4"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Отмена" Width="90" Height="30" Margin="5,0,5,0" Click="Cancel_Click" Background="#E53E3E" Foreground="White" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="ConfirmButton" Content="Подтвердить импорт" Width="150" Height="30" Margin="5,0,5,0" Click="Confirm_Click" Background="#2ECC71" Foreground="White" BorderThickness="0" FontWeight="Medium">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>