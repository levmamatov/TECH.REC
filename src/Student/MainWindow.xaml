<Window x:Class="Technic_accounting_student.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Technic_accounting_student"
        mc:Ignorable="d"
        Title="Регистрация пользователя"
        WindowStyle="None"
        WindowState="Maximized"      
        Topmost="True"            
        Height="780"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F6F7">

    <Grid>
        <Grid x:Name="LoginPanel" Visibility="Visible">
            <Border Width="500"
                    Padding="30"
                    Background="White"
                    CornerRadius="15"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="💻" FontSize="42" HorizontalAlignment="Center"/>

                    <TextBlock Text="Регистрация пользователя"
                               FontSize="28" FontWeight="Light" Foreground="#333"
                               HorizontalAlignment="Center" Margin="0,10,0,5"/>

                    <TextBlock Text="Для начала работы необходимо подтвердить данные"
                               Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <TextBlock Text="👤 Фамилия" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtLastName" Height="35" FontSize="14" Margin="0,0,0,12"/>

                    <TextBlock Text="📝 Имя" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtFirstName" Height="35" FontSize="14" Margin="0,0,0,12"/>

                    <TextBlock Text="🎓 Группа" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cbGroup" Height="35" DisplayMemberPath="GroupName" Margin="0,0,0,15"/>

                    <TextBlock Text="🔑 Способ авторизации" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <UniformGrid Columns="2" Margin="0,0,0,15">
                        <RadioButton x:Name="rbMethodCard" Content="🪪 Студенческий билет" 
                                     IsChecked="True" Checked="rbMethod_Checked" GroupName="AuthMethod" FontWeight="Medium"/>
                        <RadioButton x:Name="rbMethodTelegram" Content="✈️ Telegram аккаунт" 
                                     Checked="rbMethod_Checked" GroupName="AuthMethod" FontWeight="Medium"/>
                    </UniformGrid>

                    <TextBlock x:Name="lblIdentifierTitle" Text="🪪 Номер студенческого билета" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtIdentifier" Height="35" FontSize="14" Margin="0,0,0,25"/>

                    <Button x:Name="btnLogin"
                            Content="✅ Подтвердить данные"
                            Height="45"
                            Background="#4E73DF"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Click="btnLogin_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <TextBlock x:Name="lblSupportLink" 
           Text="Возникли проблемы?" 
           Foreground="#4E73DF" 
           HorizontalAlignment="Center" 
           Margin="0,20,0,0" 
           Cursor="Hand"
           MouseLeftButtonDown="lblSupportLink_MouseLeftButtonDown">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="TextDecorations" Value="Underline"/>
                                        <Setter Property="Foreground" Value="#224ABE"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>    

                    <Border Background="#F8F9FA" CornerRadius="8" Margin="0,20,0,0" Padding="10">
                        <StackPanel>
                            <TextBlock Text="ℹ Информация" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock Text="После подтверждения будет автоматически зарегистрирована сессия работы за данным устройством."
                                       TextWrapping="Wrap" Foreground="Gray" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="SuccessPanel" Visibility="Collapsed">
            <Border Width="500"
                    Padding="30"
                    Background="White"
                    CornerRadius="15"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="✅" FontSize="42" HorizontalAlignment="Center"/>

                    <TextBlock Text="Авторизация выполнена"
                               FontSize="28" FontWeight="Light" Foreground="#333"
                               HorizontalAlignment="Center" Margin="0,10,0,5"/>

                    <TextBlock Text="Сессия успешно зарегистрирована"
                               Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                    <TextBlock Text="👤 Студент" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="txtSuccessStudent" FontSize="14" Margin="0,0,0,15"/>

                    <TextBlock Text="🎓 Группа" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="txtSuccessGroup" FontSize="14" Margin="0,0,0,15"/>

                    <TextBlock Text="💻 Инвентарный номер" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="txtSuccessInventory" FontSize="14" Margin="0,0,0,15"/>

                    <TextBlock Text="🕒 Время начала" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="txtSuccessStart" FontSize="14" Margin="0,0,0,25"/>

                    <Button Name="btnExitAndShutdown" Content="Завершить работу и выключить ПК" Click="btnExitAndShutdown_Click" Background="Red" Foreground="White" FontWeight="Bold" Height="50" Margin="10"/>
                    <Border Background="#F8F9FA" CornerRadius="8" Padding="10">
                        <StackPanel>
                            <TextBlock Text="ℹ Информация" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock Text="Данные сохранены в журнале учёта техники. После завершения работы просто выйдите из системы Windows."
                                       TextWrapping="Wrap" Foreground="Gray" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>